@model ECommerceMVC.Models.Api.CartDto?

@{
    ViewData["Title"] = "Shopping Cart";
    var itemCount = Model?.Items?.Count ?? 0;
    var totalQuantity = Model?.Items?.Sum(x => x.Quantity) ?? 0;
}

<div class="py-5">
    <div class="container">

        <!-- ===================================================== -->
        <!-- CHECKOUT PROGRESS STEPPER -->
        <!-- ===================================================== -->
        <div class="checkout-stepper">
            <div class="stepper-step active">
                <span class="step-circle"><i class="bi bi-cart3"></i></span>
                <span class="d-none d-sm-inline">1. Shopping Cart</span>
            </div>
            <div class="stepper-divider"></div>
            <div class="stepper-step">
                <span class="step-circle">2</span>
                <span class="d-none d-sm-inline">2. Review &amp; Order</span>
            </div>
            <div class="stepper-divider"></div>
            <div class="stepper-step">
                <span class="step-circle">3</span>
                <span class="d-none d-sm-inline">3. Payment</span>
            </div>
        </div>

        @if (Model == null || Model.Items == null || !Model.Items.Any())
        {
            <!-- EMPTY CART STATE -->
            <div class="text-center py-5 my-4 bg-white rounded-4 border p-5 max-w-600 mx-auto shadow-sm">
                <div class="display-2 text-muted mb-3"><i class="bi bi-cart-x"></i></div>
                <h3 class="font-serif fw-bold mb-2">Your Shopping Cart is Empty</h3>
                <p class="text-muted mb-4">
                    Looks like you haven't selected any homemade pickles yet. Explore our freshly prepared authentic batches and spice up your meals!
                </p>
                <a asp-controller="Products" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-arrow-left"></i>
                    <span>Explore All Pickles</span>
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="font-serif display-6 fw-bold mb-1">Your Shopping <span class="text-primary font-serif">Cart</span></h1>
                    <p class="text-muted mb-0">Review your selected items before proceeding to secure checkout.</p>
                </div>
                <a asp-controller="Products" asp-action="Index" class="text-muted small fw-bold text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                </a>
            </div>

            <div class="row g-4 align-items-start">

                <!-- LEFT: CART ITEMS LIST -->
                <div class="col-lg-8">
                    <div class="cart-items-card">

                        <!-- HEADER BAR -->
                        <div class="p-3 px-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-muted text-uppercase">
                                Selected Products (@itemCount @(itemCount == 1 ? "item" : "items"))
                            </span>
                            <span class="small text-muted">@totalQuantity total units</span>
                        </div>

                        <!-- ITEMS ROWS -->
                        <div class="cart-items-list">
                            @foreach (var item in Model.Items)
                            {
                                <div class="cart-item-row">
                                    <!-- THUMBNAIL -->
                                    <div class="cart-thumb">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light fs-3">🥫</div>
                                        }
                                    </div>

                                    <!-- DETAILS -->
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-1">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                                @item.ProductName
                                            </a>
                                        </h5>
                                        <div class="text-primary fw-bold mb-2">
                                            Rs. @item.UnitPrice.ToString("N2") <span class="text-muted small fw-normal">/ jar</span>
                                        </div>

                                        <!-- QUANTITY UPDATE FORM -->
                                        <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex align-items-center gap-2 m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />

                                            <div class="product-qty-stepper" style="height: 36px; width: 100px;">
                                                <button type="button" class="btn-stepper btn-stepper-minus" style="height: 36px;" aria-label="Decrease quantity">−</button>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="input-stepper" style="height: 36px;" aria-label="Item quantity" />
                                                <button type="button" class="btn-stepper btn-stepper-plus" style="height: 36px;" aria-label="Increase quantity">+</button>
                                            </div>

                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Update Quantity">
                                                Update
                                            </button>
                                        </form>
                                    </div>

                                    <!-- SUBTOTAL & REMOVE -->
                                    <div class="text-md-end d-flex flex-md-column justify-content-between align-items-end gap-2">
                                        <div>
                                            <span class="text-muted small d-block">Subtotal</span>
                                            <span class="fs-5 fw-bold text-dark">Rs. @item.SubTotal.ToString("N2")</span>
                                        </div>

                                        <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-link text-danger p-0 small text-decoration-none" title="Remove product from cart">
                                                <i class="bi bi-trash3 me-1"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- CART FOOTER -->
                        <div class="p-3 px-4 bg-light border-top d-flex justify-content-between align-items-center">
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Add More Pickles
                            </a>

                            <form asp-controller="Cart" asp-action="Clear" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to clear your shopping cart?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Clear Cart
                                </button>
                            </form>
                        </div>

                    </div>
                </div>

                <!-- RIGHT: ORDER SUMMARY -->
                <div class="col-lg-4">
                    <div class="order-summary-box">
                        <span class="section-eyebrow mb-2">SUMMARY</span>
                        <h4 class="font-serif fw-bold mb-3">Order Summary</h4>

                        <div class="summary-line">
                            <span>Selected Items</span>
                            <strong>@itemCount (@totalQuantity units)</strong>
                        </div>

                        <div class="summary-line">
                            <span>Subtotal</span>
                            <strong>Rs. @Model.TotalAmount.ToString("N2")</strong>
                        </div>

                        <div class="summary-line">
                            <span>Standard Delivery</span>
                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Calculated at Checkout</span>
                        </div>

                        <div class="summary-total-line">
                            <div>
                                <span class="d-block fw-bold text-dark">Total Amount</span>
                                <span class="text-muted small">Inclusive of applicable taxes</span>
                            </div>
                            <span class="summary-total-price">Rs. @Model.TotalAmount.ToString("N2")</span>
                        </div>

                        <a asp-controller="Checkout" asp-action="Index" class="btn-primary-custom w-100 py-3 mb-3 text-center">
                            <span>Proceed to Checkout</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center gap-2 mb-2 text-dark fw-bold small">
                                <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                                <span>100% Safe &amp; Secure Checkout</span>
                            </div>
                            <p class="text-muted mb-0" style="font-size: 0.8rem;">
                                We support Cash on Delivery, eSewa, and Khalti for swift and protected payment.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>
</div>