@model ECommerceMVC.Models.Api.CartDto?

@{
    ViewData["Title"] = "Shopping Cart";

    var itemCount = Model?.Items?.Count ?? 0;
    var totalQuantity = Model?.Items?.Sum(x => x.Quantity) ?? 0;
}

<div class="cart-page">

    <div class="container py-5">

        <!-- ===================================================== -->
        <!-- CART HEADER -->
        <!-- ===================================================== -->

        <div class="cart-page-header">

            <div>

                <div class="section-eyebrow">
                    YOUR SHOPPING BAG
                </div>

                <h1>
                    Your <span>Cart</span>
                </h1>

                <p>
                    Review your selected homemade products before checkout.
                </p>

            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="cart-continue-shopping">

                <span>←</span>

                Continue Shopping

            </a>

        </div>


        <!-- ===================================================== -->
        <!-- SUCCESS MESSAGE -->
        <!-- ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="modern-alert modern-alert-success alert alert-dismissible fade show"
                 role="alert">

                <div class="alert-icon">
                    ✓
                </div>

                <div>
                    @TempData["Success"]
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- ERROR MESSAGE -->
        <!-- ===================================================== -->
        @if (TempData["Error"] != null)
        {
            <div class="modern-alert modern-alert-danger alert alert-dismissible fade show"
                 role="alert">

                <div class="alert-icon">
                    !
                </div>

                <div>
                    @TempData["Error"]
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- EMPTY CART -->
        <!-- ===================================================== -->
        @if (Model == null ||
                     Model.Items == null ||
                     !Model.Items.Any())
        {
            <div class="empty-cart-card">

                <div class="empty-cart-icon">
                    🛒
                </div>

                <div class="section-eyebrow">
                    YOUR CART IS WAITING
                </div>

                <h2>
                    Your cart is <span>empty</span>
                </h2>

                <p>
                    Discover delicious traditional homemade products
                    and add your favorites to your cart.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn-primary-custom">

                    Explore Products

                    <span>→</span>

                </a>

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- CART PROGRESS -->
            <!-- ================================================= -->

            <div class="cart-progress">

                <div class="cart-progress-step active">

                    <div class="cart-progress-number">
                        1
                    </div>

                    <div>
                        <strong>Shopping Cart</strong>
                        <span>Review your items</span>
                    </div>

                </div>


                <div class="cart-progress-line active"></div>


                <div class="cart-progress-step">

                    <div class="cart-progress-number">
                        2
                    </div>

                    <div>
                        <strong>Checkout</strong>
                        <span>Delivery details</span>
                    </div>

                </div>


                <div class="cart-progress-line"></div>


                <div class="cart-progress-step">

                    <div class="cart-progress-number">
                        3
                    </div>

                    <div>
                        <strong>Payment</strong>
                        <span>Secure payment</span>
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- CART STATS -->
            <!-- ================================================= -->

            <div class="cart-summary-strip">

                <div class="cart-summary-stat">

                    <span class="cart-summary-icon">
                        🛍️
                    </span>

                    <div>

                        <small>PRODUCTS</small>

                        <strong>
                            @itemCount Items
                        </strong>

                    </div>

                </div>


                <div class="cart-summary-stat">

                    <span class="cart-summary-icon">
                        📦
                    </span>

                    <div>

                        <small>TOTAL QUANTITY</small>

                        <strong>
                            @totalQuantity Units
                        </strong>

                    </div>

                </div>


                <div class="cart-summary-stat">

                    <span class="cart-summary-icon">
                        💳
                    </span>

                    <div>

                        <small>PAYMENT</small>

                        <strong>
                            Secure Checkout
                        </strong>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MAIN CART CONTENT -->
            <!-- ================================================= -->

            <div class="row g-4 align-items-start">

                <!-- ============================================= -->
                <!-- CART ITEMS -->
                <!-- ============================================= -->

                <div class="col-lg-8">

                    <div class="premium-cart-card">

                        <!-- CARD HEADER -->

                        <div class="premium-cart-header">

                            <div>

                                <h4>
                                    Your Selected Products
                                </h4>

                                <p>
                                    @itemCount product@(itemCount != 1 ? "s" : "")
                                    ready for checkout
                                </p>

                            </div>

                            <span class="cart-item-count-badge">

                                @itemCount Item@(itemCount != 1 ? "s" : "")

                            </span>

                        </div>


                        <!-- CART ITEMS -->

                        <div class="cart-items-list">

                            @foreach (var item in Model.Items)
                            {
                                <div class="premium-cart-item">

                                    <!-- PRODUCT IMAGE -->

                                    <div class="cart-product-image">

                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <div class="cart-image-placeholder">
                                                📦
                                            </div>
                                        }

                                    </div>


                                    <!-- PRODUCT DETAILS -->

                                    <div class="cart-product-details">

                                        <div class="cart-product-main">

                                            <h5>
                                                @item.ProductName
                                            </h5>

                                            <span class="cart-product-price">

                                                Rs. @item.UnitPrice.ToString("N2")

                                                <small>
                                                    / each
                                                </small>

                                            </span>

                                        </div>


                                        <!-- QUANTITY -->

                                        <div class="cart-quantity-section">

                                            <span class="cart-label">
                                                QUANTITY
                                            </span>


                                            <form asp-controller="Cart"
                                                  asp-action="Update"
                                                  method="post"
                                                  class="cart-update-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@item.ProductId" />


                                                <div class="cart-quantity-control">

                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           class="form-control cart-quantity-input" />

                                                    <button type="submit"
                                                            class="cart-update-button"
                                                            title="Update quantity">

                                                        Update

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>


                                    <!-- SUBTOTAL -->

                                    <div class="cart-item-subtotal">

                                        <span>
                                            ITEM TOTAL
                                        </span>

                                        <strong>

                                            Rs. @item.SubTotal.ToString("N2")

                                        </strong>

                                    </div>


                                    <!-- REMOVE -->

                                    <div class="cart-remove-section">

                                        <form asp-controller="Cart"
                                              asp-action="Remove"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="cart-remove-button"
                                                    title="Remove product">

                                                ✕
                                                <span>Remove</span>

                                            </button>

                                        </form>

                                    </div>

                                </div>
                            }

                        </div>


                        <!-- CART FOOTER -->

                        <div class="premium-cart-footer">

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="cart-footer-link">

                                ← Continue Shopping

                            </a>


                            <form asp-controller="Cart"
                                  asp-action="Clear"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="cart-clear-button">

                                    🗑 Clear Cart

                                </button>

                            </form>

                        </div>

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- ORDER SUMMARY -->
                <!-- ============================================= -->

                <div class="col-lg-4">

                    <div class="order-summary-card">

                        <div class="order-summary-top">

                            <div class="summary-icon">
                                🧾
                            </div>

                            <div>

                                <span class="section-eyebrow">
                                    ORDER SUMMARY
                                </span>

                                <h4>
                                    Ready to checkout?
                                </h4>

                            </div>

                        </div>


                        <div class="summary-divider"></div>


                        <!-- ITEMS -->

                        <div class="summary-row">

                            <span>

                                Products
                                <small>@itemCount item@(itemCount != 1 ? "s" : "")</small>

                            </span>

                            <strong>

                                @totalQuantity

                            </strong>

                        </div>


                        <!-- SUBTOTAL -->

                        <div class="summary-row">

                            <span>
                                Subtotal
                            </span>

                            <strong>

                                Rs. @Model.TotalAmount.ToString("N2")

                            </strong>

                        </div>


                        <!-- DELIVERY -->

                        <div class="summary-row">

                            <span>
                                Delivery
                            </span>

                            <strong class="summary-free">

                                Calculated at checkout

                            </strong>

                        </div>


                        <div class="summary-divider"></div>


                        <!-- TOTAL -->

                        <div class="summary-total">

                            <div>

                                <span>
                                    TOTAL
                                </span>

                                <small>
                                    Including applicable charges
                                </small>

                            </div>

                            <strong>

                                Rs. @Model.TotalAmount.ToString("N2")

                            </strong>

                        </div>


                        <!-- CHECKOUT BUTTON -->

                        <a asp-controller="Checkout"
                           asp-action="Index"
                           class="checkout-button">

                            <span>
                                Proceed to Checkout
                            </span>

                            <span class="checkout-arrow">
                                →
                            </span>

                        </a>


                        <!-- SECURITY -->

                        <div class="secure-checkout-note">

                            <span>
                                🔒
                            </span>

                            <p>

                                Secure checkout.
                                Your payment information is protected.

                            </p>

                        </div>

                    </div>


                    <!-- TRUST CARD -->

                    <div class="cart-trust-card">

                        <div class="cart-trust-item">

                            <span>
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Quality Products
                                </strong>

                                <small>
                                    Carefully selected products
                                </small>

                            </div>

                        </div>


                        <div class="cart-trust-item">

                            <span>
                                🔒
                            </span>

                            <div>

                                <strong>
                                    Secure Payment
                                </strong>

                                <small>
                                    Safe and protected checkout
                                </small>

                            </div>

                        </div>


                        <div class="cart-trust-item">

                            <span>
                                🚚
                            </span>

                            <div>

                                <strong>
                                    Easy Ordering
                                </strong>

                                <small>
                                    Simple and convenient process
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>