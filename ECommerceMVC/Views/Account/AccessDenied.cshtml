@{
    ViewData["Title"] = "Access Restricted";
}

<div class="py-5">
    <div class="container max-w-600 mx-auto text-center">
        <div class="card shadow-sm border-0 rounded-4 p-5 bg-white">
            <div class="brand-icon-box mx-auto mb-3 bg-warning-subtle text-warning" style="width: 76px; height: 76px; font-size: 2.2rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <span class="section-eyebrow mb-2">ACCESS CONTROL</span>
            <h1 class="font-serif display-6 fw-bold mb-2">Access Restricted</h1>
            <p class="text-muted mb-4">
                You do not have permission to view this resource. Please verify your login credentials or return to the storefront.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-secondary-custom">
                    Sign In
                </a>
            </div>
        </div>
    </div>
</div>