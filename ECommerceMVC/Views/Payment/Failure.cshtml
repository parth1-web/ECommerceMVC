@{
    ViewData["Title"] = "Payment Incomplete";

    var message =
        ViewBag.Message as string
        ?? "Your payment could not be completed.";

    var transactionUuid =
        ViewBag.TransactionUuid as string;
}

<div class="payment-result-page py-5">
    <div class="container max-w-600 mx-auto">

        <div class="card payment-result-card shadow-sm border-0 rounded-4 overflow-hidden bg-white text-center p-4 p-md-5">

            <!-- ================================================= -->
            <!-- STATUS ICON -->
            <!-- ================================================= -->
            <div class="brand-icon-box payment-status-icon mx-auto mb-4 bg-danger-subtle text-danger"
                 aria-hidden="true">
                <i class="bi bi-x-circle-fill"></i>
            </div>

            <!-- ================================================= -->
            <!-- STATUS LABEL -->
            <!-- ================================================= -->
            <span class="section-eyebrow mb-2">
                TRANSACTION NOTICE
            </span>

            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->
            <h1 class="font-serif display-6 fw-bold text-danger mb-2">
                Payment Incomplete
            </h1>

            <!-- ================================================= -->
            <!-- MESSAGE -->
            <!-- ================================================= -->
            <p class="text-muted fs-6 mb-4">
                @message
            </p>

            <!-- ================================================= -->
            <!-- TRANSACTION UUID -->
            <!-- ================================================= -->
            @if (!string.IsNullOrWhiteSpace(transactionUuid))
            {
                <div class="p-3 bg-light rounded-3 border text-start mb-4">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1">
                        Transaction UUID
                    </span>

                    <code class="text-break small text-dark fw-bold">
                        @transactionUuid
                    </code>
                </div>
            }

            <!-- ================================================= -->
            <!-- ORDER INFORMATION -->
            <!-- ================================================= -->
            <div class="p-3 bg-light rounded-3 border mb-4 text-start">

                <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-bold small">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span>Don't worry, your order is saved!</span>
                </div>

                <p class="text-muted small mb-0">
                    Your order is safely recorded in our system as
                    <strong>Pending</strong>.
                    You can retry paying with Cash on Delivery or another
                    digital wallet anytime from your orders page.
                </p>

            </div>

            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->
            <div class="d-flex flex-wrap justify-content-center gap-3">

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn-primary-custom">
                    <i class="bi bi-box-seam me-1"></i>
                    <span>Go to My Orders</span>
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn-secondary-custom">
                    <i class="bi bi-shop me-1"></i>
                    <span>Continue Shopping</span>
                </a>

            </div>

        </div>

    </div>
</div>