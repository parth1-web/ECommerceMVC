@{
    ViewData["Title"] = "Payment Failed";

    var message = ViewBag.Message as string;
    var transactionUuid = ViewBag.TransactionUuid as string;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <div style="font-size: 80px;">

                        ❌

                    </div>


                    <h1 class="mt-3 text-danger">

                        Payment Failed

                    </h1>


                    <p class="text-muted fs-5">

                        @message

                    </p>


                    @if (!string.IsNullOrWhiteSpace(transactionUuid))
                    {
                        <div class="alert alert-light text-start mt-4">

                            <strong>
                                Transaction UUID:
                            </strong>

                            <div class="text-break mt-1">

                                @transactionUuid

                            </div>

                        </div>
                    }


                    <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-center
                        gap-2
                        mt-4">

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="btn btn-primary">

                            My Orders

                        </a>


                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>