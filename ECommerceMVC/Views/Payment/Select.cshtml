@model ECommerceMVC.Models.Api.OrderDto

@{
    ViewData["Title"] = "Select Payment";
}

<div class="container py-5">

    <!-- ============================================== -->
    <!-- HEADER -->
    <!-- ============================================== -->

    <div class="text-center mb-5">

        <h1>
            Select Payment Method
        </h1>

        <p class="text-muted">
            Choose how you want to pay for your order.
        </p>

    </div>


    <!-- ============================================== -->
    <!-- ORDER SUMMARY -->
    <!-- ============================================== -->

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Order Summary
                    </h5>

                </div>

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span>
                            Order
                        </span>

                        <strong>
                            #@Model.Id
                        </strong>

                    </div>

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <span>
                            Items
                        </span>

                        <span>
                            @Model.Items.Count
                        </span>

                    </div>

                    <hr />

                    <div class="d-flex
                        justify-content-between">

                        <strong>
                            Total
                        </strong>

                        <strong class="text-success fs-5">

                            Rs.
                            @Model.TotalAmount.ToString("N2")

                        </strong>

                    </div>

                </div>

            </div>


            <!-- ============================================== -->
            <!-- PAYMENT METHODS -->
            <!-- ============================================== -->

            <div class="card shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">
                        Payment Method
                    </h5>

                </div>

                <div class="card-body">

                    <form asp-controller="Payment"
                          asp-action="Process"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="orderId"
                               value="@Model.Id" />


                        <!-- ====================================== -->
                        <!-- COD -->
                        <!-- ====================================== -->

                        <div class="form-check border rounded p-3 mb-3">

                            <input class="form-check-input"
                                   type="radio"
                                   name="method"
                                   id="cod"
                                   value="1"
                                   checked />

                            <label class="form-check-label w-100"
                                   for="cod">

                                <strong>
                                    Cash on Delivery
                                </strong>

                                <span class="d-block text-muted mt-1">
                                    Pay when your order is delivered.
                                </span>

                            </label>

                        </div>


                        <!-- ====================================== -->
                        <!-- KHALTI -->
                        <!-- ====================================== -->

                        <div class="form-check border rounded p-3 mb-3">

                            <input class="form-check-input"
                                   type="radio"
                                   name="method"
                                   id="khalti"
                                   value="2" />

                            <label class="form-check-label w-100"
                                   for="khalti">

                                <strong>
                                    Khalti
                                </strong>

                                <span class="d-block text-muted mt-1">
                                    Pay securely through Khalti.
                                </span>

                            </label>

                        </div>


                        <!-- ====================================== -->
                        <!-- ESEWA -->
                        <!-- ====================================== -->

                        <div class="form-check border rounded p-3 mb-4">

                            <input class="form-check-input"
                                   type="radio"
                                   name="method"
                                   id="esewa"
                                   value="3" />

                            <label class="form-check-label w-100"
                                   for="esewa">

                                <strong>
                                    eSewa
                                </strong>

                                <span class="d-block text-muted mt-1">
                                    Pay securely through eSewa.
                                </span>

                            </label>

                        </div>


                        <!-- ====================================== -->
                        <!-- BUTTON -->
                        <!-- ====================================== -->

                        <button type="submit"
                                class="btn btn-success
                            btn-lg w-100">

                            Continue to Payment

                        </button>


                        <a asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary
                            w-100 mt-2">

                            Back to Order

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>