@model ECommerceMVC.Models.Api.EsewaInitiateResponseDto

@{
    ViewData["Title"] = "Redirecting to eSewa";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <!-- ===================================== -->
                    <!-- LOADING ICON -->
                    <!-- ===================================== -->

                    <div class="mb-4"
                         style="font-size: 60px;">

                        ⏳

                    </div>


                    <!-- ===================================== -->
                    <!-- TITLE -->
                    <!-- ===================================== -->

                    <h2 class="mb-3">

                        Redirecting to eSewa

                    </h2>


                    <!-- ===================================== -->
                    <!-- DESCRIPTION -->
                    <!-- ===================================== -->

                    <p class="text-muted mb-4">

                        Please wait while we redirect you to the
                        secure eSewa payment gateway.

                    </p>


                    <!-- ===================================== -->
                    <!-- ESEWA PAYMENT FORM -->
                    <!-- ===================================== -->

                    <form id="esewaPaymentForm"
                          action="@Model.PaymentUrl"
                          method="post">


                        <!-- AMOUNT -->

                        <input type="hidden"
                               name="amount"
                               value="@Model.FormData.Amount" />


                        <!-- TAX AMOUNT -->

                        <input type="hidden"
                               name="tax_amount"
                               value="@Model.FormData.TaxAmount" />


                        <!-- TOTAL AMOUNT -->

                        <input type="hidden"
                               name="total_amount"
                               value="@Model.FormData.TotalAmount" />


                        <!-- TRANSACTION UUID -->

                        <input type="hidden"
                               name="transaction_uuid"
                               value="@Model.FormData.TransactionUuid" />


                        <!-- PRODUCT CODE -->

                        <input type="hidden"
                               name="product_code"
                               value="@Model.FormData.ProductCode" />


                        <!-- SERVICE CHARGE -->

                        <input type="hidden"
                               name="product_service_charge"
                               value="@Model.FormData.ProductServiceCharge" />


                        <!-- DELIVERY CHARGE -->

                        <input type="hidden"
                               name="product_delivery_charge"
                               value="@Model.FormData.ProductDeliveryCharge" />


                        <!-- SUCCESS URL -->

                        <input type="hidden"
                               name="success_url"
                               value="@Model.FormData.SuccessUrl" />


                        <!-- FAILURE URL -->

                        <input type="hidden"
                               name="failure_url"
                               value="@Model.FormData.FailureUrl" />


                        <!-- SIGNED FIELD NAMES -->

                        <input type="hidden"
                               name="signed_field_names"
                               value="@Model.FormData.SignedFieldNames" />


                        <!-- SIGNATURE -->

                        <input type="hidden"
                               name="signature"
                               value="@Model.FormData.Signature" />


                        <!-- ================================= -->
                        <!-- FALLBACK BUTTON -->
                        <!-- ================================= -->

                        <button type="submit"
                                class="btn btn-success btn-lg">

                            Continue to eSewa

                        </button>

                    </form>


                    <!-- ===================================== -->
                    <!-- LOADING SPINNER -->
                    <!-- ===================================== -->

                    <div class="mt-4">

                        <div class="spinner-border text-success"
                             role="status">

                            <span class="visually-hidden">

                                Redirecting to eSewa...

                            </span>

                        </div>

                    </div>


                    <!-- ===================================== -->
                    <!-- SECURITY MESSAGE -->
                    <!-- ===================================== -->

                    <p class="small text-muted mt-4 mb-0">

                        🔒 You are being redirected to a secure
                        payment gateway.

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const form =
                    document.getElementById(
                        "esewaPaymentForm");

                if (form) {

                    form.submit();

                }

            });

    </script>
}