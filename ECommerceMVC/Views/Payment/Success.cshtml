@model ECommerceMVC.Models.Api.PaymentDto?

@{
    ViewData["Title"] = "Payment Successful";
    var orderId = ViewBag.OrderId;
    var transactionUuid = ViewBag.TransactionUuid as string;
}

<div class="py-5">
    <div class="container max-w-700 mx-auto">

        <!-- SUCCESS RECEIPT CARD -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white text-center p-5">

            <div class="brand-icon-box mx-auto mb-3 bg-success-subtle text-success" style="width: 80px; height: 80px; font-size: 2.5rem;">
                <i class="bi bi-check2-circle"></i>
            </div>

            <span class="section-eyebrow mb-2">PAYMENT CONFIRMED</span>
            <h1 class="font-serif display-5 fw-bold text-success mb-2">Payment Successful!</h1>
            <p class="text-muted fs-6 mb-4">
                Thank you! Your payment for Order <strong class="text-dark">#@orderId</strong> has been verified.
            </p>

            <div class="p-4 bg-light rounded-4 border text-start mb-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-bold d-block">Order Number</span>
                        <span class="fs-5 fw-bold font-serif text-dark">#@orderId</span>
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-bold d-block">Payment Status</span>
                        <span class="badge bg-success text-white rounded-pill px-3 py-1">
                            <i class="bi bi-check-circle-fill me-1"></i> Verified &amp; Paid
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(transactionUuid))
                    {
                        <div class="col-12 pt-2 border-top">
                            <span class="text-muted small text-uppercase fw-bold d-block">Transaction UUID</span>
                            <div class="d-flex align-items-center justify-content-between gap-2 mt-1">
                                <code class="text-break small text-dark fw-bold">@transactionUuid</code>
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" onclick="navigator.clipboard.writeText('@transactionUuid'); alert('Transaction UUID copied!');" title="Copy UUID">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    }

                    @if (Model != null)
                    {
                        <div class="col-sm-6 pt-2 border-top">
                            <span class="text-muted small text-uppercase fw-bold d-block">Amount Paid</span>
                            <span class="fs-5 fw-bold text-primary">Rs. @Model.Amount.ToString("N2")</span>
                        </div>
                        <div class="col-sm-6 pt-2 border-top">
                            <span class="text-muted small text-uppercase fw-bold d-block">Payment Method</span>
                            <span class="fw-bold text-dark">
                                @(Model.Method == 1 ? "Cash on Delivery" : Model.Method == 2 ? "Khalti Wallet" : Model.Method == 3 ? "eSewa Wallet" : "Digital Payment")
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@orderId" class="btn-primary-custom">
                    <span>View Order Status</span>
                    <i class="bi bi-arrow-right"></i>
                </a>

                <button type="button" class="btn-secondary-custom" onclick="window.print();">
                    <i class="bi bi-printer"></i>
                    <span>Print Receipt</span>
                </button>

                <a asp-controller="Products" asp-action="Index" class="btn btn-link text-muted small text-decoration-none w-100 mt-2">
                    <i class="bi bi-shop me-1"></i> Continue Shopping
                </a>
            </div>

        </div>

    </div>
</div>
</div>