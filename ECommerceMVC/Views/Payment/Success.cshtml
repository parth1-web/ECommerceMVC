@model ECommerceMVC.Models.Api.PaymentDto?

@{
    ViewData["Title"] = "Payment Successful";

    var orderId = ViewBag.OrderId;
    var transactionUuid = ViewBag.TransactionUuid;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <!-- SUCCESS ICON -->

                    <div style="font-size: 80px;">

                        ✅

                    </div>


                    <h1 class="mt-3 text-success">

                        Payment Successful!

                    </h1>


                    <p class="text-muted fs-5">

                        Your payment has been verified successfully.

                    </p>


                    <hr class="my-4" />


                    <!-- ORDER INFORMATION -->

                    <div class="row text-start">

                        <div class="col-md-6 mb-3">

                            <span class="text-muted">

                                Order Number

                            </span>

                            <h5>

                                #@orderId

                            </h5>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(transactionUuid))
                        {
                            <div class="col-md-6 mb-3">

                                <span class="text-muted">

                                    Transaction UUID

                                </span>

                                <h6 class="text-break">

                                    @transactionUuid

                                </h6>

                            </div>
                        }

                    </div>


                    <!-- PAYMENT INFORMATION -->
                    @if (Model != null)
                    {
                        <hr />

                        <div class="row text-start">

                            <div class="col-md-6 mb-3">

                                <span class="text-muted">

                                    Payment Status

                                </span>

                                <h5 class="text-success">

                                    @Model.Status

                                </h5>

                            </div>

                        </div>
                    }


                    <!-- ACTIONS -->

                    <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-center
                        gap-2
                        mt-4">

                        <a asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@orderId"
                           class="btn btn-primary">

                            View Order

                        </a>


                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>