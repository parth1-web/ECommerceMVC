@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-body">

            <h2>My Profile</h2>

            <hr />

            <p>
                <strong>Authenticated:</strong>
                @User.Identity?.IsAuthenticated
            </p>

            <p>
                <strong>Name:</strong>
                @User.Identity?.Name
            </p>

            <p>
                <strong>Email:</strong>
                @User.FindFirst("email")?.Value
            </p>

        </div>

    </div>

</div>