@{
    ViewData["Title"] = "My Profile";
    var userName = User.Identity?.Name ?? "Valued Customer";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value ?? userName;
}

<div class="py-5">
    <div class="container max-w-800 mx-auto">

        <!-- PROFILE HEADER -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4 bg-white p-4">
            <div class="d-flex flex-column flex-sm-row align-items-center gap-4 text-center text-sm-start">
                <div class="user-avatar-circle flex-shrink-0" style="width: 84px; height: 84px; font-size: 2.2rem;">
                    @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                </div>

                <div class="flex-grow-1">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small mb-2">
                        <i class="bi bi-patch-check-fill me-1"></i> Verified Customer
                    </span>
                    <h2 class="font-serif fw-bold mb-1">@userName</h2>
                    <div class="text-muted small mb-0">
                        <i class="bi bi-envelope me-1"></i> @userEmail
                    </div>
                </div>

                <div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- QUICK ACTION CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <a asp-controller="Orders" asp-action="Index" class="card h-100 p-3 rounded-4 border bg-white shadow-xs text-decoration-none hover-lift">
                    <div class="text-primary fs-3 mb-2"><i class="bi bi-box-seam"></i></div>
                    <h6 class="fw-bold text-dark mb-1">My Orders</h6>
                    <span class="text-muted small">View history &amp; track deliveries</span>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Cart" asp-action="Index" class="card h-100 p-3 rounded-4 border bg-white shadow-xs text-decoration-none hover-lift">
                    <div class="text-primary fs-3 mb-2"><i class="bi bi-bag-heart"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Shopping Bag</h6>
                    <span class="text-muted small">Review items ready for order</span>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Products" asp-action="Index" class="card h-100 p-3 rounded-4 border bg-white shadow-xs text-decoration-none hover-lift">
                    <div class="text-primary fs-3 mb-2"><i class="bi bi-shop"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Browse Catalog</h6>
                    <span class="text-muted small">Discover fresh achar batches</span>
                </a>
            </div>
        </div>

        <!-- ACCOUNT SECURITY & INFO -->
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
            <h5 class="font-serif fw-bold mb-3">Account Information</h5>
            <div class="list-group list-group-flush small">
                <div class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Account Status:</span>
                    <span class="text-success fw-bold">Active</span>
                </div>
                <div class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Authentication Mode:</span>
                    <span class="text-dark fw-bold">Encrypted Session &amp; Cookie</span>
                </div>
                <div class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Registered Email:</span>
                    <span class="text-dark fw-bold">@userEmail</span>
                </div>
            </div>
        </div>

    </div>
</div>
</div>