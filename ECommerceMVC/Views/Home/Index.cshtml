@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">

    <h1 class="display-4">
        Welcome to Gaun Ko Achar
    </h1>

    <p class="lead">
        Authentic homemade Nepali achar delivered to your door.
    </p>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary btn-lg">

        Shop Now

    </a>

</div>


<div class="row text-center mt-5">

    <div class="col-md-4">

        <h3>Authentic</h3>

        <p>
            Traditional Nepali flavors made with care.
        </p>

    </div>


    <div class="col-md-4">

        <h3>Fresh</h3>

        <p>
            Quality ingredients and homemade preparation.
        </p>

    </div>


    <div class="col-md-4">

        <h3>Delivered</h3>

        <p>
            Convenient delivery directly to your home.
        </p>

    </div>

</div>