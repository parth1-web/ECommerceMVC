@model ECommerceMVC.Models.ProductViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="product-details-container">
    <div class="container">

        <!-- BREADCRUMB -->
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Home</a>
            <span>/</span>
            <a asp-controller="Products" asp-action="Index">Shop All</a>
            <span>/</span>
            <span class="text-dark fw-bold text-truncate" style="max-width: 250px;">@Model.Name</span>
        </nav>

        <div class="row g-5 align-items-start">

            <!-- LEFT: PRODUCT IMAGE -->
            <div class="col-lg-6">
                <div class="details-image-card position-relative">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="details-main-img" />
                    }
                    else
                    {
                        <div class="details-main-img d-flex flex-column align-items-center justify-content-center bg-light text-muted">
                            <span class="display-1">🥫</span>
                            <span class="fw-bold mt-2">Gaun Ko Achar</span>
                        </div>
                    }

                    @if (Model.IsAvailable)
                    {
                        <span class="position-absolute top-0 start-0 m-4 badge bg-success text-white rounded-pill px-3 py-2 shadow-sm">
                            <i class="bi bi-patch-check-fill me-1"></i> Freshly Cured Batch
                        </span>
                    }
                </div>

                <!-- TRUST BADGES UNDER IMAGE -->
                <div class="row g-3 mt-3 text-center">
                    <div class="col-4">
                        <div class="p-3 bg-white rounded-3 border">
                            <i class="bi bi-sun text-warning fs-4 d-block mb-1"></i>
                            <span class="small fw-bold text-dark d-block">Sun-Cured</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Natural aging</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-white rounded-3 border">
                            <i class="bi bi-heart-pulse text-danger fs-4 d-block mb-1"></i>
                            <span class="small fw-bold text-dark d-block">Mustard Oil</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Cold-pressed</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-white rounded-3 border">
                            <i class="bi bi-shield-check text-success fs-4 d-block mb-1"></i>
                            <span class="small fw-bold text-dark d-block">Pure Spice</span>
                            <span class="text-muted" style="font-size: 0.75rem;">No chemicals</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: DETAILS & PURCHASE -->
            <div class="col-lg-6">
                <div class="details-info-box">

                    <span class="section-eyebrow">
                        <i class="bi bi-flower1"></i> AUTHENTIC NEPALI FLAVOR
                    </span>

                    <h1 class="details-title">@Model.Name</h1>

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                        <div class="details-price-badge mb-0">
                            <span class="details-price">Rs. @Model.Price.ToString("N2")</span>
                            <span class="details-tax-note">/ sealed glass jar</span>
                        </div>

                        <div>
                            @if (Model.IsAvailable && Model.Stock > 0)
                            {
                                <span class="details-stock-pill in-stock">
                                    <i class="bi bi-check-circle-fill"></i> In Stock (@Model.Stock available)
                                </span>
                            }
                            else
                            {
                                <span class="details-stock-pill out-of-stock">
                                    <i class="bi bi-x-circle-fill"></i> Currently Out of Stock
                                </span>
                            }
                        </div>
                    </div>

                    <p class="lead text-muted fs-6 mb-4">
                        @Model.Description
                    </p>

                    <!-- ADD TO CART FORM -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (Model.IsAvailable && Model.Stock > 0)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post" class="p-4 bg-light rounded-4 border mb-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Id" />

                                <div class="row align-items-center g-3">
                                    <div class="col-sm-4">
                                        <label class="form-label fw-bold small text-muted text-uppercase">Quantity</label>
                                        <div class="product-qty-stepper w-100 bg-white" style="height: 48px;">
                                            <button type="button" class="btn-stepper btn-stepper-minus" style="height: 48px;" aria-label="Decrease quantity">−</button>
                                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.Stock" class="input-stepper flex-grow-1" style="height: 48px;" aria-label="Quantity" />
                                            <button type="button" class="btn-stepper btn-stepper-plus" style="height: 48px;" aria-label="Increase quantity">+</button>
                                        </div>
                                    </div>

                                    <div class="col-sm-8">
                                        <label class="form-label d-none d-sm-block">&nbsp;</label>
                                        <button type="submit" class="btn-primary-custom w-100 py-3">
                                            <i class="bi bi-bag-plus-fill me-1"></i>
                                            <span>Add to Cart</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                <div>
                                    <strong>Temporarily Out of Stock</strong>
                                    <div class="small text-muted">A new batch is currently fermenting in the sun and will be ready soon.</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 bg-light rounded-4 border mb-4 text-center">
                            <div class="fs-2 text-primary mb-2"><i class="bi bi-shield-lock-fill"></i></div>
                            <h5 class="fw-bold mb-1">Ready to Order?</h5>
                            <p class="text-muted small mb-3">Sign in or register an account to add this product to your cart and place an order.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">
                                Sign In to Buy
                            </a>
                        </div>
                    }

                    <!-- TASTE & INGREDIENT NOTES -->
                    <div class="details-tabs">
                        <ul class="nav nav-tabs border-bottom" id="productTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold small" id="ingredients-tab" data-bs-toggle="tab" data-bs-target="#ingredients" type="button" role="tab" aria-selected="true">
                                    <i class="bi bi-egg-fried me-1"></i> Ingredients &amp; Spices
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small" id="serving-tab" data-bs-toggle="tab" data-bs-target="#serving" type="button" role="tab" aria-selected="false">
                                    <i class="bi bi-cup-hot me-1"></i> Best Pairings
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold small" id="storage-tab" data-bs-toggle="tab" data-bs-target="#storage" type="button" role="tab" aria-selected="false">
                                    <i class="bi bi-box2 me-1"></i> Storage &amp; Shelf Life
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content pt-3" id="productTabContent">
                            <div class="tab-pane fade show active small text-muted" id="ingredients" role="tabpanel">
                                Fresh hand-picked Himalayan produce, pure cold-pressed mustard oil, ground turmeric, Himalayan rock salt, roasted fenugreek (methi), wild timbur pepper, yellow mustard seeds, and natural spices. 100% free of artificial vinegar and chemical colors.
                            </div>
                            <div class="tab-pane fade small text-muted" id="serving" role="tabpanel">
                                Pairs exceptionally well with steaming hot Dal Bhat Tarkari, fried Sel Roti, Chiura (beaten rice) &amp; Sekuwa, steaming Momos, or as a tangy companion to parathas.
                            </div>
                            <div class="tab-pane fade small text-muted" id="storage" role="tabpanel">
                                Store in a cool, dry place away from direct moisture. Always use a clean, dry spoon to serve. Keep oil level slightly above pickles for natural preservation. Best consumed within 6 months of opening.
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <a asp-controller="Products" asp-action="Index" class="text-muted small fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Back to All Pickles
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>