@model ErrorViewModel

@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="py-5">
    <div class="container max-w-600 mx-auto text-center">
        <div class="card shadow-sm border-0 rounded-4 p-5 bg-white">
            <div class="brand-icon-box mx-auto mb-3 bg-danger-subtle text-danger" style="width: 76px; height: 76px; font-size: 2.2rem;">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
            <span class="section-eyebrow mb-2">SYSTEM NOTICE</span>
            <h1 class="font-serif display-6 fw-bold text-danger mb-2">Something Went Wrong</h1>
            <p class="text-muted mb-4">
                We encountered an unexpected issue while processing your request. Please try again or return to the storefront.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded-3 border mb-4 text-start">
                    <span class="text-muted small text-uppercase fw-bold d-block">Request ID</span>
                    <code class="text-break small text-dark fw-bold">@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn-secondary-custom">
                    Explore Shop
                </a>
            </div>
        </div>
    </div>
</div>

