@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string controllerName)
    {
        return string.Equals(
            controller,
            controllerName,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Gaun Ko Achar - Authentic homemade Nepali achar delivered to your door." />

    <title>
        @ViewData["Title"] - Gaun Ko Achar
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="icon"
          href="~/favicon.ico" />

</head>

<body>

    <!-- ================================================= -->
    <!-- TOP ANNOUNCEMENT BAR -->
    <!-- ================================================= -->

    <div class="announcement-bar">

        <div class="container">

            <div class="announcement-content">

                <span>
                    🚚 Free delivery on selected orders
                </span>

                <span class="announcement-divider">
                    •
                </span>

                <span>
                    🌶️ Authentic homemade Nepali flavors
                </span>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- NAVBAR -->
    <!-- ================================================= -->

    <header class="site-header">

        <nav class="navbar navbar-expand-lg navbar-light">

            <div class="container">

                <!-- BRAND -->

                <a class="navbar-brand brand-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">

                        🌶️

                    </span>

                    <span class="brand-text">

                        <strong>Gaun Ko</strong>

                        <small>Achar</small>

                    </span>

                </a>


                <!-- MOBILE TOGGLE -->

                <button class="navbar-toggler custom-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- LEFT NAVIGATION -->

                    <ul class="navbar-nav nav-main mx-auto">

                        <li class="nav-item">

                            <a class="nav-link @Active("Home")"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @Active("Products")"
                               asp-controller="Products"
                               asp-action="Index">

                                Shop

                            </a>

                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link @Active("Orders")"
                                   asp-controller="Orders"
                                   asp-action="Index">

                                    My Orders

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- RIGHT NAVIGATION -->

                    <div class="navbar-actions">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- CART -->

                            <a class="cart-button"
                               asp-controller="Cart"
                               asp-action="Index">

                                <span class="cart-icon">

                                    🛒

                                </span>

                                <span class="cart-text">

                                    Cart

                                </span>

                            </a>


                            <!-- USER -->

                            <div class="dropdown user-dropdown">

                                <button class="btn user-menu-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="user-avatar">

                                        @(User.Identity?.Name?
                                            .Substring(0, 1)
                                            .ToUpper() ?? "U")

                                    </span>

                                    <span class="user-name">

                                        @(User.Identity?.Name ?? "Account")

                                    </span>

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Home"
                                           asp-action="Profile">

                                            👤 My Profile

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Orders"
                                           asp-action="Index">

                                            📦 My Orders

                                        </a>

                                    </li>


                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>


                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item logout-item">

                                                🚪 Logout

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <a class="login-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>


                            <a class="register-button"
                               asp-controller="Account"
                               asp-action="Register">

                                Create Account

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ================================================= -->
    <!-- TEMP DATA MESSAGES -->
    <!-- ================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container notification-container">

            <div class="alert modern-alert modern-alert-success alert-dismissible fade show"
                 role="alert">

                <div class="alert-icon">

                    ✓

                </div>

                <div>

                    <strong>Success!</strong>

                    <span>
                        @TempData["SuccessMessage"]
                    </span>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container notification-container">

            <div class="alert modern-alert modern-alert-danger alert-dismissible fade show"
                 role="alert">

                <div class="alert-icon">

                    !

                </div>

                <div>

                    <strong>Something went wrong</strong>

                    <span>
                        @TempData["ErrorMessage"]
                    </span>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        </div>
    }


    <!-- ================================================= -->
    <!-- PAGE CONTENT -->
    <!-- ================================================= -->

    <main role="main"
          class="site-main">

        @RenderBody()

    </main>


    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-grid">

                <!-- BRAND -->

                <div class="footer-brand">

                    <a class="footer-logo"
                       asp-controller="Home"
                       asp-action="Index">

                        🌶️ Gaun Ko Achar

                    </a>

                    <p>

                        Authentic homemade Nepali flavors,
                        prepared with care and delivered
                        with love.

                    </p>

                </div>


                <!-- SHOP -->

                <div class="footer-column">

                    <h6>

                        Shop

                    </h6>

                    <a asp-controller="Products"
                       asp-action="Index">

                        All Products

                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index">

                        Categories

                    </a>

                </div>


                <!-- ACCOUNT -->

                <div class="footer-column">

                    <h6>

                        Account

                    </h6>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Orders"
                           asp-action="Index">

                            My Orders

                        </a>

                        <a asp-controller="Cart"
                           asp-action="Index">

                            Shopping Cart

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                        <a asp-controller="Account"
                           asp-action="Register">

                            Create Account

                        </a>
                    }

                </div>


                <!-- TRUST -->

                <div class="footer-column">

                    <h6>

                        Why Us

                    </h6>

                    <span>

                        🌿 Homemade

                    </span>

                    <span>

                        ⭐ Quality Ingredients

                    </span>

                    <span>

                        🚚 Convenient Delivery

                    </span>

                </div>

            </div>


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">

                <span>

                    © @DateTime.Now.Year Gaun Ko Achar.
                    All rights reserved.

                </span>


                <div class="footer-links">

                    <a asp-controller="Home"
                       asp-action="Privacy">

                        Privacy

                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- ================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>