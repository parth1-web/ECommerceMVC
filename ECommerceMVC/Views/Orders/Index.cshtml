@model IEnumerable<ECommerceMVC.Models.Api.OrderDto>

@{
    ViewData["Title"] = "My Orders";

    var orders = Model?
        .OrderByDescending(x => x.OrderDate)
        .ToList()
        ?? new List<ECommerceMVC.Models.Api.OrderDto>();
}

<div class="orders-page">

    <!-- ===================================================== -->
    <!-- PAGE HERO -->
    <!-- ===================================================== -->

    <section class="orders-hero">

        <div class="container">

            <div class="orders-hero-content">

                <div class="orders-hero-text">

                    <span class="page-eyebrow">
                        <span class="eyebrow-icon">📦</span>
                        ORDER MANAGEMENT
                    </span>

                    <h1>
                        My <span>Orders</span>
                    </h1>

                    <p>
                        Track your purchases, review your order details,
                        and stay updated on every stage of delivery.
                    </p>

                </div>


                <div class="orders-hero-action">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn-primary-custom">

                        <span class="btn-icon">
                            🛍️
                        </span>

                        <span>
                            Continue Shopping
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <section class="orders-content">

        <div class="container">


            <!-- ================================================= -->
            <!-- SUCCESS MESSAGE -->
            <!-- ================================================= -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert modern-alert modern-alert-success
                    alert-dismissible fade show"
                     role="alert">

                    <div class="alert-message-content">

                        <div class="alert-icon">
                            ✓
                        </div>

                        <div class="alert-text">

                            @TempData["SuccessMessage"]

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>
            }


            <!-- ================================================= -->
            <!-- ERROR MESSAGE -->
            <!-- ================================================= -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert modern-alert modern-alert-danger
                    alert-dismissible fade show"
                     role="alert">

                    <div class="alert-message-content">

                        <div class="alert-icon">
                            !
                        </div>

                        <div class="alert-text">

                            @TempData["ErrorMessage"]

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>
            }


            <!-- ================================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================================= -->
            @if (!orders.Any())
            {
                <div class="empty-orders">

                    <div class="empty-orders-icon">
                        📦
                    </div>

                    <span class="empty-orders-eyebrow">
                        NO PURCHASES YET
                    </span>

                    <h2>
                        No orders yet
                    </h2>

                    <p>
                        You haven't placed any orders yet.
                        Explore our collection and find something you love.
                    </p>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn-primary-custom">

                        <span class="btn-icon">
                            🛍️
                        </span>

                        <span>
                            Start Shopping
                        </span>

                    </a>

                </div>
            }
            else
            {

                <!-- ================================================= -->
                <!-- ORDERS SUMMARY -->
                <!-- ================================================= -->

                <div class="orders-summary-row">

                    <div class="orders-summary-info">

                        <div class="orders-summary-count">

                            <span class="orders-count">

                                @orders.Count

                            </span>

                            <div class="orders-count-content">

                                <strong>

                                    @(orders.Count == 1
                                        ? "Total Order"
                                        : "Total Orders")

                                </strong>

                                <span>
                                    Your purchase history
                                </span>

                            </div>

                        </div>

                    </div>


                    <p class="orders-summary-description">

                        Review your recent purchases and track
                        the progress of your orders.

                    </p>

                </div>


                <!-- ================================================= -->
                <!-- ORDERS LIST -->
                <!-- ================================================= -->

                <div class="orders-list">

                    @foreach (var order in orders)
                    {
                        /*
                         * IMPORTANT:
                         *
                         * Store values in variables before displaying them.
                         *
                         * This avoids Razor parsing problems such as:
                         *
                         * 02/09/2026 08:06:05.ToLocalTime()
                         * .ToString("dd MMM yyyy")
                         *
                         * appearing literally in the browser.
                         */

                        var itemCount = order.Items?.Count ?? 0;

                        var orderDate = order.OrderDate.ToLocalTime();

                        var formattedDate =
                            orderDate.ToString("dd MMM yyyy");

                        var formattedTime =
                            orderDate.ToString("hh:mm tt");

                        var formattedAmount =
                            order.TotalAmount.ToString("N2");

                        string statusText;
                        string statusClass;

                        switch (order.Status)
                        {
                            case 1:
                                statusText = "Pending";
                                statusClass = "status-pending";
                                break;

                            case 2:
                                statusText = "Confirmed";
                                statusClass = "status-confirmed";
                                break;

                            case 3:
                                statusText = "Processing";
                                statusClass = "status-processing";
                                break;

                            case 4:
                                statusText = "Shipped";
                                statusClass = "status-shipped";
                                break;

                            case 5:
                                statusText = "Delivered";
                                statusClass = "status-delivered";
                                break;

                            case 6:
                                statusText = "Cancelled";
                                statusClass = "status-cancelled";
                                break;

                            default:
                                statusText = "Unknown";
                                statusClass = "status-default";
                                break;
                        }


                        <!-- ========================================= -->
                        <!-- ORDER CARD -->
                        <!-- ========================================= -->

                        <article class="modern-order-card">


                            <!-- ===================================== -->
                            <!-- CARD HEADER -->
                            <!-- ===================================== -->

                            <div class="modern-order-header">


                                <!-- ORDER ID -->

                                <div class="order-header-left">

                                    <div class="order-icon">

                                        📦

                                    </div>


                                    <div class="order-header-information">

                                        <span class="order-label">

                                            ORDER

                                        </span>

                                        <h4>

                                            #@order.Id

                                        </h4>

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div class="order-status-wrapper">

                                    <span class="order-status @statusClass">

                                        <span class="status-dot"></span>

                                        @statusText

                                    </span>

                                </div>

                            </div>


                            <!-- ===================================== -->
                            <!-- CARD BODY -->
                            <!-- ===================================== -->

                            <div class="modern-order-body">


                                <!-- ================================= -->
                                <!-- ORDER DATE -->
                                <!-- ================================= -->

                                <div class="order-info">

                                    <span class="order-info-label">

                                        ORDER DATE

                                    </span>

                                    <strong>

                                        @formattedDate

                                    </strong>

                                    <small>

                                        @formattedTime

                                    </small>

                                </div>


                                <!-- ================================= -->
                                <!-- ITEMS -->
                                <!-- ================================= -->

                                <div class="order-info">

                                    <span class="order-info-label">

                                        ITEMS

                                    </span>

                                    <strong>

                                        @itemCount
                                        @(itemCount == 1 ? " item" : " items")

                                    </strong>

                                    <small>

                                        Products in this order

                                    </small>

                                </div>


                                <!-- ================================= -->
                                <!-- TOTAL -->
                                <!-- ================================= -->

                                <div class="order-info order-total-info">

                                    <span class="order-info-label">

                                        TOTAL AMOUNT

                                    </span>

                                    <strong class="order-total">

                                        Rs. @formattedAmount

                                    </strong>

                                    <small>

                                        Total payable amount

                                    </small>

                                </div>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <div class="order-action">

                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn-order-details">

                                        <span>
                                            View Details
                                        </span>

                                        <span class="button-arrow">
                                            →
                                        </span>

                                    </a>

                                </div>

                            </div>

                        </article>
                    }

                </div>

            }

        </div>

    </section>

</div>