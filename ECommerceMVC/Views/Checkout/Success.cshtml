@model ECommerceMVC.Models.Api.OrderDto

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm text-center">

                <div class="card-body p-5">

                    <div style="font-size: 70px;">
                        ✅
                    </div>


                    <h1 class="mt-3">
                        Order Confirmed!
                    </h1>


                    <p class="text-muted">

                        Thank you for your purchase.

                    </p>


                    <hr />


                    <div class="row text-start mt-4">

                        <div class="col-md-6">

                            <p class="mb-1 text-muted">
                                Order ID
                            </p>

                            <h5>
                                #@Model.Id
                            </h5>

                        </div>


                        <div class="col-md-6">

                            <p class="mb-1 text-muted">
                                Order Date
                            </p>

                            <h5>
                                @Model.OrderDate.ToLocalTime()
                            </h5>

                        </div>

                    </div>


                    <div class="row text-start mt-3">

                        <div class="col-md-6">

                            <p class="mb-1 text-muted">
                                Status
                            </p>

                            <h5>
                                @Model.Status
                            </h5>

                        </div>


                        <div class="col-md-6">

                            <p class="mb-1 text-muted">
                                Total
                            </p>

                            <h5 class="text-primary">

                                Rs.
                                @Model.TotalAmount.ToString("N2")

                            </h5>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <div class="d-flex
                        justify-content-center
                        gap-2">

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-primary">

                            Continue Shopping

                        </a>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            My Orders

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>