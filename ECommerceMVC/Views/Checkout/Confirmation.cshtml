@model ECommerceMVC.Models.Api.OrderDto

@{
    ViewData["Title"] = $"Order #{Model.Id} Confirmation";

    var statusText = Model.Status switch
    {
        1 => "Pending Payment",
        2 => "Confirmed",
        3 => "Processing",
        4 => "Shipped",
        5 => "Delivered",
        6 => "Cancelled",
        _ => $"Status {Model.Status}"
    };

    var statusClass = Model.Status switch
    {
        1 => "status-pending",
        2 => "status-confirmed",
        3 => "status-processing",
        4 => "status-shipped",
        5 => "status-delivered",
        6 => "status-cancelled",
        _ => "status-default"
    };

    var canPay = Model.Status == 1;
}

<div class="py-5">
    <div class="container max-w-800 mx-auto">

        <!-- CELEBRATION HEADER -->
        <div class="text-center mb-5">
            <div class="brand-icon-box mx-auto mb-3 bg-success-subtle text-success" style="width: 72px; height: 72px; font-size: 2.2rem;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <span class="section-eyebrow mb-2">ORDER REGISTERED SUCCESSFULLY</span>
            <h1 class="font-serif display-5 fw-bold mb-2">Thank You for Your Order!</h1>
            <p class="text-muted lead fs-6">
                Your order <strong class="text-dark">#@Model.Id</strong> has been placed into our kitchen pipeline.
            </p>
        </div>

        <!-- RECEIPT CARD -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4 bg-white">
            
            <div class="p-4 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="text-muted small text-uppercase fw-bold d-block">Order Reference</span>
                    <span class="fs-4 fw-bold font-serif text-dark">#@Model.Id</span>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-bold d-block">Order Placed Date</span>
                    <span class="fw-bold text-dark">@Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-bold d-block">Status</span>
                    <span class="status-badge @statusClass">
                        <span class="status-dot"></span> @statusText
                    </span>
                </div>
            </div>

            <!-- ITEMS TABLE -->
            <div class="p-4">
                <h6 class="fw-bold text-muted text-uppercase small mb-3">Purchased Items</h6>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null)
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fs-4">🥫</span>
                                                <span class="fw-bold text-dark">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end text-muted">Rs. @item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end fw-bold">Rs. @item.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="border-top-2">
                            <tr>
                                <td colspan="3" class="text-end text-muted">Standard Delivery:</td>
                                <td class="text-end text-success fw-bold">FREE</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fs-5 fw-bold text-dark">Total Amount:</td>
                                <td class="text-end fs-5 fw-bold text-primary">Rs. @Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- NEXT ACTIONS BAR -->
            <div class="p-4 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> Print Invoice
                    </button>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-shop me-1"></i> Continue Shopping
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (canPay)
                    {
                        <a asp-controller="Payment" asp-action="Select" asp-route-id="@Model.Id" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold">
                            <i class="bi bi-credit-card me-1"></i> Complete Payment Now
                        </a>
                    }
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-dark btn-sm rounded-pill px-3">
                        <span>View All Orders</span> <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>

        </div>

    </div>
</div>

